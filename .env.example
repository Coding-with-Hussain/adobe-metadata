# MetadataGen Gemini — server configuration.
# Copy to .env.local and fill in. Every value is read on the server only.
# Never prefix these with NEXT_PUBLIC_, and never commit a real key.
# Empty values fall back to the defaults shown.

# Required for AI generation. Create a key in Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Model ID. Default: gemini-3.6-flash
GEMINI_MODEL=

# Comma-separated allowlist of models the server may call. Default: gemini-3.6-flash,gemini-3.5-flash
# GEMINI_MODEL must be in this list.
GEMINI_ALLOWED_MODELS=

# Optional Gemini thinking level: minimal | low | medium | high. Default: the model's own default.
# Lower levels are faster and cheaper; metadata rarely needs deep reasoning.
GEMINI_THINKING_LEVEL=

# Per-asset time budget for the Gemini call(s), in milliseconds. Default: 120000
GEMINI_REQUEST_TIMEOUT_MS=

# --- Media limits (the UI reads these from /api/health) ---
# Max selected image size (JPEG/PNG/WEBP), MB. Default: 50
MAX_IMAGE_MB=
# Max SVG size, MB. Default: 5
MAX_SVG_MB=
# Max video size (MP4/MOV), MB. Default: 100
MAX_VIDEO_MB=
# Max video duration, seconds (checked in the browser). Default: 300
MAX_VIDEO_SECONDS=
# Max image payload sent for analysis, MB (larger images are downscaled first). Default and max: 14
MAX_ANALYSIS_IMAGE_MB=
# Videos up to this size are sent inline; larger ones use the Gemini Files API. Default and max: 14
INLINE_VIDEO_MAX_MB=
# Max files per batch. Default: 500 (max 1000)
MAX_BATCH_FILES=
# Files processed in parallel per browser tab. Default: 3 (1–8)
CLIENT_CONCURRENCY=

# --- Spend guards (in-memory, per server process) ---
# Generation requests per minute per client IP. Default: 60
RATE_LIMIT_PER_MINUTE=
# Total generation requests per UTC day for this server process; 0 = unlimited. Default: 2000
DAILY_REQUEST_CAP=
